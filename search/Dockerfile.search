FROM python:3.11-slim

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .

# Install only needed deps for search service
RUN pip install --no-cache-dir -r requirements.txt

# Copy service code
COPY . /app

# ✅ Dynamic worker scaling (2 × CPU cores by default)
ENV WORKERS="2 * $(nproc)"

CMD ["sh", "-c", "gunicorn -w $((WORKERS)) -k uvicorn.workers.UvicornWorker --preload app:app --bind 0.0.0.0:8000"]
